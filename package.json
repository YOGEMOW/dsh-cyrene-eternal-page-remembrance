{
  "name": "dsh-cyrene-eternal-page-remembrance",
  "version": "0.5.4",
  "private": false,
  "type": "module",
  "description": "一页永恒：昔涟的长期记忆（四问锚点 + 日月年 + 艾宾浩斯 + 比例调度 + 夜梦 + 思源镜像 + 余页）",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-memory",
    "memory",
    "siyuan",
    "cyrene"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOGEMOW/dsh-cyrene-eternal-page-remembrance.git"
  },
  "bugs": {
    "url": "https://github.com/YOGEMOW/dsh-cyrene-eternal-page-remembrance/issues"
  },
  "homepage": "https://github.com/YOGEMOW/dsh-cyrene-eternal-page-remembrance#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
